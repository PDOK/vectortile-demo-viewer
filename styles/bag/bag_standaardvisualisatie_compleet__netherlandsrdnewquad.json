{
  "version": 8,
  "name": "BAG Standaard Visualisatie compleet",
  "id": "bag_standaardvisualisatie_compleet",
  "pitch": 50,
  "center": [
    0,
    0
  ],
  "sprite": "https://api.pdok.nl/kadaster/bag/ogc/v2/resources/standaardsprites/sprites",
