    {
      "id": "Huisnummer adres",
      "type": "symbol",
      "paint": {
        "text-opacity": 1,
        "text-color":   "rgb(0,0,0)",
        "text-halo-color":    "rgb(255,255,255)",
        "text-halo-width": 2
      },
          "layout": { "symbol-placement": "point",
          "text-anchor": "bottom",
          "text-line-height": 1.2,
          "text-field": "{huisnummer}",
          "text-font": ["sans-serif"],
          "text-size": 13,
          "text-justify": "center"
        }


      ,
      "source": "bag",
      "source-layer": "adres"
    }
    ],
    "sources": {
      "bag": {
        "type": "vector",
        "tiles": [
          "https://api.pdok.nl/kadaster/bag/ogc/v2/tiles/NetherlandsRDNewQuad/{z}/{y}/{x}?f=mvt"
        ],
        "minzoom": 12,
        "maxzoom": 12
      }
    }
